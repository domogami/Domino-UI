{
  "$schema": "./schema.json",
  "schemaVersion": 1,
  "name": "Domino UI",
  "version": "0.1.0",
  "defaultTheme": "hybrid",
  "palette": {
    "paper": "#efe7d7",
    "ink": "#252b2e",
    "teal": "#0e7c79",
    "mint": "#43d0c1",
    "charcoal": "#2b3034",
    "terracotta": "#a34e36",
    "sage": "#d5e3cd",
    "peach": "#eed5bf",
    "lavender": "#ded9e8",
    "bluePaper": "#c6d9de",
    "surfaceLight": "#f7f3e9",
    "raisedLight": "#fcf9f1",
    "mutedLight": "#696b63",
    "borderLight": "#c8c0b1",
    "accentInkLight": "#fffdf7",
    "sidebarLight": "#f0eadd",
    "sidebarMutedLight": "#656a64",
    "sidebarBorderLight": "#cfc5b4",
    "sidebarActiveLight": "#dde3d2",
    "sidebarMutedDark": "#b1b5aa",
    "sidebarBorderDark": "#50565a",
    "sidebarActiveDark": "#414b47",
    "accentDark": "#b6cf8e",
    "surfaceDark": "#323b3e",
    "raisedDark": "#394347",
    "mutedDark": "#b1b4a8",
    "borderDark": "#566164",
    "sageDark": "#3e5144",
    "peachDark": "#614e42",
    "lavenderDark": "#4a455a",
    "bluePaperDark": "#384e57",
    "dangerDark": "#e5b29f",
    "terracottaDark": "#e6b78d"
  },
  "shared": {
    "grid-size": "32px",
    "font-heading": "\"Poppins\", sans-serif",
    "font-body": "\"Lexend\", sans-serif",
    "font-mono": "\"IBM Plex Mono\", monospace",
    "font-hand": "\"Caveat\", cursive",
    "font-lettered": "\"Kalam\", cursive",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px",
    "space-16": "64px",
    "radius": "3px 7px 5px 4px",
    "duration-fast": "160ms",
    "duration-base": "240ms",
    "menu-duration": "360ms",
    "menu-easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "switch-duration": "360ms",
    "switch-easing": "cubic-bezier(0.34, 1.4, 0.64, 1)",
    "switch-press-duration": "80ms",
    "task-check-duration": "220ms",
    "task-strike-duration": "280ms",
    "skeleton-duration": "5400ms",
    "skeleton-ring-duration": "6200ms",
    "skeleton-word-stagger": "110ms",
    "sketch-duration": "1600ms",
    "sketch-stagger": "90ms",
    "name-outline-duration": "2120ms",
    "name-fill-duration": "660ms",
    "name-fill-delay": "1320ms",
    "name-period-duration": "180ms",
    "name-period-delay": "2060ms",
    "crane-duration": "2400ms",
    "crane-stagger": "130ms",
    "letter-duration": "70ms",
    "letter-stagger": "75ms",
    "plant-duration": "1800ms",
    "plant-leaf-delay": "400ms",
    "plant-pot-delay": "600ms",
    "banner-outline-duration": "800ms",
    "banner-fill-duration": "450ms",
    "banner-fill-delay": "750ms",
    "banner-label-duration": "300ms",
    "banner-label-delay": "1100ms",
    "layer-duration": "240ms",
    "dialog-duration": "320ms",
    "dialog-exit-duration": "160ms",
    "layer-exit-duration": "160ms",
    "layer-easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "shadow-layer": "2px 3px 0 color-mix(in srgb, var(--dm-ink) 16%, transparent)"
  },
  "themes": {
    "light": {
      "tokens": {
        "paper": "{palette.paper}",
        "surface": "{palette.surfaceLight}",
        "surface-raised": "{palette.raisedLight}",
        "ink": "{palette.ink}",
        "muted": "{palette.mutedLight}",
        "border": "{palette.borderLight}",
        "accent": "{palette.teal}",
        "accent-ink": "{palette.accentInkLight}",
        "sage": "{palette.sage}",
        "peach": "{palette.peach}",
        "lavender": "{palette.lavender}",
        "blue": "{palette.bluePaper}",
        "danger": "{palette.terracotta}",
        "focus": "{palette.teal}",
        "shadow": "2px 3px 0 #252b2e18",
        "grid-color": "#252b2e26",
        "sidebar": "{palette.sidebarLight}",
        "sidebar-ink": "{palette.ink}",
        "sidebar-muted": "{palette.sidebarMutedLight}",
        "sidebar-border": "{palette.sidebarBorderLight}",
        "sidebar-active": "{palette.sidebarActiveLight}",
        "sidebar-accent": "{palette.teal}",
        "mint": "{palette.mint}",
        "terracotta": "{palette.terracotta}",
        "backdrop": "rgb(25 31 31 / 48%)"
      }
    },
    "hybrid": {
      "extends": "light",
      "tokens": {
        "sidebar": "{palette.charcoal}",
        "sidebar-ink": "{palette.paper}",
        "sidebar-muted": "{palette.sidebarMutedDark}",
        "sidebar-border": "{palette.sidebarBorderDark}",
        "sidebar-active": "{palette.sidebarActiveDark}",
        "sidebar-accent": "{palette.accentDark}"
      }
    },
    "dark": {
      "extends": "light",
      "tokens": {
        "paper": "{palette.charcoal}",
        "surface": "{palette.surfaceDark}",
        "surface-raised": "{palette.raisedDark}",
        "ink": "{palette.paper}",
        "muted": "{palette.mutedDark}",
        "border": "{palette.borderDark}",
        "accent": "{palette.accentDark}",
        "accent-ink": "{palette.ink}",
        "sage": "{palette.sageDark}",
        "peach": "{palette.peachDark}",
        "lavender": "{palette.lavenderDark}",
        "blue": "{palette.bluePaperDark}",
        "danger": "{palette.dangerDark}",
        "focus": "{palette.accentDark}",
        "shadow": "2px 3px 0 #0004",
        "grid-color": "#efe7d724",
        "sidebar": "{palette.ink}",
        "sidebar-ink": "{palette.paper}",
        "sidebar-muted": "{palette.sidebarMutedDark}",
        "sidebar-border": "{palette.sidebarBorderDark}",
        "sidebar-active": "{palette.sidebarActiveDark}",
        "sidebar-accent": "{palette.accentDark}",
        "mint": "{palette.accentDark}",
        "terracotta": "{palette.terracottaDark}",
        "backdrop": "rgb(5 10 12 / 70%)"
      }
    }
  },
  "fonts": [
    {
      "family": "Poppins",
      "weight": "500",
      "file": "Poppins-Medium.woff2",
      "license": "poppins-OFL.txt",
      "format": "woff2",
      "mime": "font/woff2"
    },
    {
      "family": "Poppins",
      "weight": "600",
      "file": "Poppins-Semibold.woff2",
      "license": "poppins-OFL.txt",
      "format": "woff2",
      "mime": "font/woff2"
    },
    {
      "family": "Poppins",
      "weight": "700",
      "file": "Poppins-Bold.woff2",
      "license": "poppins-OFL.txt",
      "format": "woff2",
      "mime": "font/woff2"
    },
    {
      "family": "Lexend",
      "weight": "300 400",
      "file": "Lexend-Light.ttf",
      "license": "lexend-OFL.txt",
      "format": "truetype",
      "mime": "font/ttf"
    },
    {
      "family": "Lexend",
      "weight": "500 700",
      "file": "Lexend-Medium.ttf",
      "license": "lexend-OFL.txt",
      "format": "truetype",
      "mime": "font/ttf"
    },
    {
      "family": "IBM Plex Mono",
      "weight": "400 600",
      "file": "IBMPlexMono-Regular.woff2",
      "license": "ibmplexmono-OFL.txt",
      "format": "woff2",
      "mime": "font/woff2"
    },
    {
      "family": "Caveat",
      "weight": "400 700",
      "file": "Caveat.woff2",
      "license": "caveat-OFL.txt",
      "format": "woff2",
      "mime": "font/woff2"
    },
    {
      "family": "Kalam",
      "weight": "700",
      "file": "Kalam-Bold.ttf",
      "license": "Kalam-OFL.txt",
      "format": "truetype",
      "mime": "font/ttf"
    }
  ]
}
